# Cole estes nomes no painel Vercel → Project → Settings → Environment Variables
# Os valores reais estão no arquivo local .env.vercel.local (não commitado).
# Gerados via Render CLI (instabuss-db) + secrets aleatórios.

DATABASE_URL=postgresql://USER:PASS@HOST:5432/instabuss?sslmode=require
ADMIN_ACCESS_SECRET=
ADMIN_JWT_SECRET=
ADMIN_BOOTSTRAP_SECRET=
FRONTEND_URL=https://SEU-PROJETO.vercel.app
# Mesmo valor de ADMIN_ACCESS_SECRET — embute no front no build da Vercel
VITE_ADMIN_ACCESS_SECRET=
DATABASE_SSL=true
