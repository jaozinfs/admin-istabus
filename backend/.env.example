PORT=3100
DATABASE_URL=postgresql://user:pass@host:5432/instabuss
# Obrigatório. Mesmo valor no header X-Admin-Secret de todas as requests (front + API).
ADMIN_ACCESS_SECRET=change-me-long-random
# Obrigatório. Assina JWT do operador.
ADMIN_JWT_SECRET=change-me-another-long-random
# Obrigatório só no primeiro bootstrap (criar o único login).
ADMIN_BOOTSTRAP_SECRET=change-me-bootstrap-once
# Origens do front (CORS). Separar por vírgula.
FRONTEND_URL=http://localhost:5173
JWT_EXPIRES_IN=12h
# Opcional: para ler cota_* do produto Stripe (igual o InstaBuss)
STRIPE_SECRET_KEY=
FREE_QUOTA_FEED=5
FREE_QUOTA_STORY=5
FREE_QUOTA_GENIA=3
FREE_QUOTA_WHATSAPP_BROADCAST_META=0

